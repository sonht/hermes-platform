# Copy to dashboard-test.env; chmod 600. Never commit the real file.
# This isolated evaluation must NOT use production API keys or credentials.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=dashboard-test-admin
# Generate with the upstream plugin hash_password helper, or use a strong
# temporary password in HERMES_DASHBOARD_BASIC_AUTH_PASSWORD instead.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Dashboard must remain isolated from production state.
HERMES_DASHBOARD=0
