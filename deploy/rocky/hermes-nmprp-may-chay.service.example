# Chay may chay NMPRP o che do NEN bang systemd (huong dan: docs/NMPRP_HERMES_MAY_CHAY_NEN.md).
# Cai tren Rocky: sudo cp <tep nay> /etc/systemd/system/hermes-nmprp-may-chay.service
# TRUNG TRON CHE DO: nap tep .env bang bash giong het khi chay tay (set -a; . tep; set +a) thay vi EnvironmentFile,
# vi systemd doc tep .env khac bash (dau nhay, $, khoang trang) va mat khau co ky tu dac biet co the bi doc sai.
# Chi MOT may chay tai mot thoi diem: dung may chay chay tay (Ctrl+C khi KHONG co luot dang chay) truoc khi bat dich vu.
[Unit]
Description=Hermes run runner for NMPRP (polls dm.kcb.vn)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=rocky
WorkingDirectory=/home/rocky/hermes-platform
ExecStart=/bin/bash -c 'set -a; . /home/rocky/hermes-platform/deploy/rocky/nmprp-service.env; set +a; exec /usr/bin/python3 -m support.nmprp_may_chay'
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
