# Credentials of the NMPRP service account used by Hermes (read-only pilot).
# Copy to deploy/rocky/nmprp-service.env on Rocky, chmod 600. NEVER commit it or paste it in chat.
# The account must have the task `studio_cpt` and must NOT be an admin (see docs/NMPRP_HERMES_API_ACCESS.md).
NMPRP_BASE_URL=
NMPRP_SERVICE_USER=
NMPRP_SERVICE_PASSWORD=
