# Credentials of the NMPRP service account used by Hermes (read-only pilot).
# Copy to deploy/rocky/nmprp-service.env on Rocky, chmod 600. NEVER commit it or paste it in chat.
# The account must have the task `studio_cpt` and must NOT be an admin (see docs/NMPRP_HERMES_API_ACCESS.md).
NMPRP_BASE_URL=
NMPRP_SERVICE_USER=
NMPRP_SERVICE_PASSWORD=

# Run runner (support/nmprp_may_chay.py) — optional, all have safe defaults. See docs/NMPRP_HERMES_MAY_CHAY.md.
# Models the admin may pick in the NMPRP tab (comma separated). EMPTY = only "the profile's default model". Never hard-coded in NMPRP.
HERMES_RUNNER_MODELS=
# Reasoning levels the admin may pick (comma separated; allowed: none,minimal,low,medium,high,xhigh,max,ultra).
HERMES_RUNNER_REASONING=low,medium,high
# While this file exists the runner takes no work and says no hello (soft stop). Create: touch <path>. Resume: rm <path>.
HERMES_RUNNER_DUNG=/home/rocky/hermes-shadow-out/DUNG

# Opt-in stage adapters. Empty preserves M1 v1 only; enable only after staging canary/review.
# Supported: m0,m2,m3,v2. Uses a separate nmprp-stages Hermes profile; never changes nmprp-mapping.
HERMES_RUNNER_STAGES=
# Durable result checkpoints. Use a DIFFERENT directory for staging and production.
HERMES_RUNNER_STAGE_STATE=/home/rocky/hermes-shadow-out/stages
