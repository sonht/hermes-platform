# Production dashboard auth only. Never commit dashboard-production.env.
# Set a unique admin account; never reuse the test password or signing secret.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# Set ONE of PASSWORD_HASH (preferred) or PASSWORD, never both.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Public URL when served at https://hermes.kcb.vn/agent behind Caddy (see
# docs/HERMES_AGENT_PATH_ROUTING.md). Used verbatim for auth redirects and added to the
# Host guard; blank counts as unset. Production (2026-10-17): https://hermes.kcb.vn/agent
# together with dashboard.trusted_proxies ["172.23.0.1"] in /opt/data/config.yaml.
HERMES_DASHBOARD_PUBLIC_URL=
