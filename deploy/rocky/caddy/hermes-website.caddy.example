# Template for /etc/caddy/conf.d/hermes-website.caddy (block hermes.kcb.vn only).
# Upstream Hermes Agent v0.22.2 (d923a5eb) supports sub-path mounting through the
# X-Forwarded-Prefix header; the backend rewrites index.html, cookies, redirects.
# Apply ONLY after the approval steps in docs/HERMES_AGENT_PATH_ROUTING.md.
# Do not copy backups (*.bak) into a directory matched by the Caddy import glob.
hermes.kcb.vn {
	encode zstd gzip

	redir /agent /agent/ 308

	handle_path /agent/* {
		# Defense in depth on top of the dashboard auth gate. Choose ONE access policy
		# (see docs) and replace the placeholder before applying.
		# @denied not remote_ip REPLACE_WITH_ALLOWED_CIDR
		# respond @denied 403
		reverse_proxy 127.0.0.1:19119 {
			header_up X-Forwarded-Prefix /agent
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8099
	}
}
